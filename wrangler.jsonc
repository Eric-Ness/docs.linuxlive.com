// Cloudflare Workers static assets: the published site is the dist/ folder that `npm run build` writes.
// The name must match the Worker that Cloudflare's GitHub integration (Workers Builds) builds.
{
  "name": "docs-linuxlive-com",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // /workshop/look redirects to /workshop/look/, as Starlight writes every page as a folder.
    "html_handling": "auto-trailing-slash"
  }
}
